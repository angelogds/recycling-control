<% layout('layouts/base') %>

<h3>Registrar Chegada</h3>

<form method="POST" action="/portaria/chegada">

    <div class="mb-3">
        <label class="form-label">Placa do Caminhão</label>
        <input type="text" name="placa" class="form-control">
    </div>

    <div class="mb-3">
        <label class="form-label">Toneladas Declaradas</label>
        <input type="number" step="0.1" name="toneladas" class="form-control">
    </div>

    <button class="btn btn-primary">Salvar</button>

</form>
