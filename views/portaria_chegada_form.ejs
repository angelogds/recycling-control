<%- include('layouts/base_top', { title: "Registrar Chegada", usuario: usuario }) %>

<h2 class="title-premium mb-4">Registrar Chegada de Caminhão</h2>

<form method="POST" action="/portaria/chegada" class="card card-premium p-4">

    <label class="form-label">Placa</label>
    <input type="text" class="form-control mb-3" name="placa">

    <label class="form-label">Toneladas Declaradas</label>
    <input type="number" step="0.1" class="form-control mb-3" name="toneladas">

    <button class="btn btn-premium w-100">Salvar</button>
</form>

<%- include('layouts/base_bottom') %>
