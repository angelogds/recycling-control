<!-- portaria_chegada_form.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Registrar Chegada — Portaria</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div>Portaria — Registrar Chegada</div>
    <div><a href="/portaria">Voltar</a></div>
  </div>

  <div class="container">
    <div class="card" style="max-width:600px; margin:auto;">
      <div class="card-title">Formulário de Chegada</div>

      <form method="POST" action="/portaria/chegada">
        <label>Número da frota</label>
        <input name="frota" placeholder="Ex: FROTA-1024" required>
        <label>Toneladas</label>
        <input name="toneladas" type="number" step="0.1" placeholder="0.0" required>
        <div style="display:flex; gap:10px;">
          <button class="btn btn-green btn-full" type="submit">Registrar Chegada</button>
          <a class="btn btn-gray btn-full" href="/portaria">Cancelar</a>
        </div>
      </form>

    </div>
  </div>
</body>
</html>
