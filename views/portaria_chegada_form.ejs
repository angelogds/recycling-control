<%- include('layouts/base_top', { title: title, usuario: usuario }) %>

<h2>Registrar Chegada</h2>
<form method="post" action="/portaria/chegada">
  <div class="mb-3">
    <label>Placa</label>
    <input name="placa" class="form-control" required>
  </div>
  <div class="mb-3">
    <label>Toneladas</label>
    <input name="toneladas" type="number" step="0.1" class="form-control" required>
  </div>
  <button class="btn btn-success">Registrar</button>
</form>

<%- include('layouts/base_bottom') %>

