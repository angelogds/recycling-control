<%- include('layouts/base_top', { title: "Registrar Chegada", usuario: usuario }) %>

<div class="container premium-box">
    <h1 class="page-title">➕ Registrar Chegada do Caminhão</h1>

    <form action="/portaria/chegada" method="POST" class="form-premium">
        
        <label>Placa do Caminhão:</label>
        <input type="text" name="placa" required placeholder="Ex: ABC1234" class="form-control form-control-lg"/>

        <label>Toneladas declaradas:</label>
        <input type="number" step="0.01" name="toneladas" required class="form-control form-control-lg"/>

        <button class="btn btn-success btn-lg w-100 mt-3">
            Confirmar Chegada
        </button>
    </form>

    <a href="/portaria" class="btn btn-secondary btn-lg w-100 mt-3">Voltar</a>
</div>

<%- include('layouts/base_bottom') %>
