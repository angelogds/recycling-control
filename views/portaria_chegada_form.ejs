<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Registrar Chegada – Portaria</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        margin: 0;
        padding: 40px;
        background: linear-gradient(135deg, #0b3f1b, #0f6a30);
        font-family: "Inter";
        color: white;
        display: flex;
        justify-content: center;
    }

    .card {
        width: 450px;
        backdrop-filter: blur(15px);
        background: rgba(255,255,255,0.1);
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 0 18px rgba(0,0,0,0.35);
    }

    h2 {
        margin-bottom: 20px;
        text-align: center;
        font-weight: 600;
    }

    label { margin-top: 10px; display: block; }
    input {
        width: 100%;
        padding: 12px;
        margin-top: 5px;
        border-radius: 8px;
        border: none;
        font-size: 16px;
    }

    .btn {
        width: 100%;
        padding: 14px;
        margin-top: 22px;
        border: none;
        border-radius: 10px;
        background: #0ac44d;
        color: white;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
    }

    .btn:hover { background: #0e9c3f; }

    .back {
        text-align: center;
        margin-top: 15px;
        display: block;
        color: #d1ffd9;
        text-decoration: none;
    }
</style>

</head>
<body>

<div class="card">

    <h2>Registrar Chegada</h2>

    <form action="/portaria/chegada" method="POST">

        <label>Placa do Caminhão</label>
        <input type="text" name="placa" required placeholder="Ex: ABC-1234">

        <label>Toneladas Declaradas</label>
        <input type="number" step="0.01" name="toneladas" required placeholder="Ex: 28.5">

        <button class="btn">Salvar Entrada</button>

    </form>

    <a href="/portaria" class="back">Voltar para a Portaria</a>

</div>

</body>
</html>
