cat > views/portaria_chegada_form.ejs << 'EOF'
<%- include("layouts/base_top", { title: "Registrar Chegada", usuario: usuario }) %>

<h2 class="title-premium mb-4">Registrar Chegada do Caminhão</h2>

<div class="card card-premium p-4">
    <form method="POST" action="/portaria/chegada">
        <div class="mb-3">
            <label class="form-label fw-bold">Placa do Caminhão</label>
            <input required name="placa" class="form-control" placeholder="ABC-1234">
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Toneladas Declaradas</label>
            <input required type="number" step="0.1" name="toneladas" class="form-control" placeholder="Ex: 12.5">
        </div>
        <div class="d-flex gap-2">
            <a href="/portaria" class="btn btn-outline-premium">Cancelar</a>
            <button class="btn btn-premium">Registrar Chegada</button>
        </div>
    </form>
</div>

<%- include("layouts/base_bottom") %>
EOF
