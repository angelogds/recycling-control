cat > views/operador/operador_login.ejs << 'EOF'
<%- include('../layouts/base_top', { title: "Login Operador", usuario: usuario }) %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card card-premium p-4">
      <h3 class="title-premium">Entrar — Operador</h3>
      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label">Usuário</label>
          <input name="username" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Senha</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <div class="d-flex justify-content-end gap-2">
          <button class="btn btn-outline-premium">Cancelar</button>
          <button class="btn btn-premium">Entrar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/base_bottom') %>
EOF
