cat > views/operador/operador_historico.ejs << 'EOF'
<%- include('../layouts/base_top', { title: "Histórico de Ciclos", usuario: usuario }) %>

<h2 class="title-premium mb-4">Histórico de Ciclos</h2>

<div class="card card-premium p-3">
  <table class="table">
    <thead>
      <tr><th>ID</th><th>Digestor</th><th>Início</th><th>Fim</th><th>Status</th><th>Ações</th></tr>
    </thead>
    <tbody id="historicoBody">
      <tr><td colspan="6" class="text-muted">Carregando...</td></tr>
    </tbody>
  </table>
</div>

<script>
async function loadHistorico(){
  const res = await fetch('/api/cycles?limit=50').then(r => r.json());
  const body = document.getElementById('historicoBody');
  body.innerHTML = '';
  if(!res || res.length===0){
    body.innerHTML = '<tr><td colspan="6" class="text-muted text-center">Nenhum ciclo encontrado</td></tr>';
    return;
  }
  res.forEach(c=>{
    body.innerHTML += `<tr>
      <td>${c.id}</td>
      <td>${c.digestor_id}</td>
      <td>${c.started_at || '-'}</td>
      <td>${c.ended_at || '-'}</td>
      <td>${c.status}</td>
      <td><a class="btn btn-outline-premium btn-sm" href="/reports/cycle/${c.id}">Gerar PDF</a></td>
    </tr>`;
  });
}
loadHistorico();
</script>

<%- include('../layouts/base_bottom') %>
EOF
