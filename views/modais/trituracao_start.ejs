<div class="modal fade" id="modalIniciarTritura" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Iniciar Trituração</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">
          <label>Tova de Origem</label>
          <select id="modal_tova" class="form-select">
            <option value="1">Tova 1</option>
            <option value="2">Tova 2</option>
          </select>
        </div>
        <div class="mb-2">
          <label>Toneladas solicitadas</label>
          <input id="modal_ton" class="form-control" placeholder="Ex: 8">
        </div>
      </div>
      <div class="modal-footer">
        <button data-bs-dismiss="modal" class="btn btn-secondary">Cancelar</button>
        <button id="modal_iniciar_btn" class="btn btn-premium">Iniciar</button>
      </div>
    </div>
  </div>
</div>
