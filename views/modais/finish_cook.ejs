<div class="modal fade" id="modalFinalizarCozimento">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Finalizar Cozimento</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="finish_cook_id">

        <p class="text-muted">Confirme que o cozimento do digestor foi concluído.</p>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-cook" onclick="finalizarCozimento()">Finalizar</button>
      </div>

    </div>
  </div>
</div>
