<!-- Modal: Finalizar Cozimento -->
<div class="modal fade" id="modalFinishCook" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-success">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Finalizar Cozimento</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="finishCookId">

                <label class="form-label">Confirmar finalização?</label>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success" onclick="confirmFinishCook()">Finalizar</button>
            </div>
        </div>
    </div>
</div>

<script>
function abrirFinishC(id) {
    document.getElementById("finishCookId").value = id;
    new bootstrap.Modal(document.getElementById("modalFinishCook")).show();
}

function confirmFinishCook() {
    const id = document.getElementById("finishCookId").value;

    fetch("/api/cooking/finish", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cooking_id: id })
    });

    bootstrap.Modal.getInstance(document.getElementById("modalFinishCook")).hide();
}
</script>
