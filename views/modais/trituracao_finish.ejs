<div class="modal fade" id="modalFinalizarTrituracao">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Finalizar Trituração</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="finish_trit_id">

        <label class="form-label">Toneladas Trituradas:</label>
        <input type="number" class="form-control" id="finish_ton" placeholder="Ex: 8">
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-finish-tritura" onclick="finalizarTrituracao()">Finalizar</button>
      </div>

    </div>
  </div>
</div>
