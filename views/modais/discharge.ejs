<div class="modal fade" id="modalDischargeDigestor">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Descarregar Digestor</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="discharge_digestor_id">

        <label class="form-label">Toneladas Descarregadas:</label>
        <input type="number" class="form-control" id="discharge_ton" placeholder="Ex: 10">

        <label class="form-label mt-3">Observações:</label>
        <textarea class="form-control" id="discharge_notes"></textarea>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-discharge" onclick="descarregarDigestor()">Descarregar</button>
      </div>

    </div>
  </div>
</div>
