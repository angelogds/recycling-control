<div class="modal fade" id="modalDischarge" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Descarregar Digestor</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label>Toneladas descarregadas</label>
        <input id="modal_dis_tons" class="form-control" placeholder="Ex: 7.5">
        <label class="mt-2">Notas (opcional)</label>
        <textarea id="modal_dis_notes" class="form-control" rows="3"></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button id="modal_do_discharge_btn" class="btn btn-premium">Descarregar</button>
      </div>
    </div>
  </div>
</div>
