<div class="modal fade" id="modalDischarge" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Descarregar Digestor</h5>
                <button type="button" class="btn-close"></button>
            </div>

            <form id="formDischarge">
                <div class="modal-body">

                    <input type="hidden" id="discharge_digestor_id">
                    <input type="hidden" id="discharge_tritura_id">
                    <input type="hidden" id="discharge_cook_id">

                    <label class="form-label">Toneladas Descarregadas:</label>
                    <input type="number" id="discharge_ton" class="form-control" required>

                    <label class="form-label mt-2">Observações:</label>
                    <textarea class="form-control" id="discharge_notes"></textarea>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-premium">Confirmar</button>
                </div>
            </form>

        </div>
    </div>
</div>
