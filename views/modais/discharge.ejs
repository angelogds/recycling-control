<div class="modal fade" id="modalDischarge" tabindex="-1">
  <div class="modal-dialog">
    <form id="formDischarge" class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Descarregar Digestor</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="d_digestor_id" name="digestor_id">
        <div class="mb-3"><label>Toneladas descartadas</label><input id="d_ton" name="toneladas_discarded" class="form-control" type="number" step="0.1"></div>
        <div class="mb-3"><label>Observações</label><textarea id="d_notes" name="notes" class="form-control"></textarea></div>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button><button class="btn btn-warning" type="submit">Descarregar</button></div>
    </form>
  </div>
</div>
