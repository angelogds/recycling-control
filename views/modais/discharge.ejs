<div class="modal">
    <h2>Descarregamento do Digestor</h2>

    <form id="discharge-form">
        <label>ID do Digestor:</label>
        <input type="number" name="digestor_id" required>

        <label>ID Trituração (opcional):</label>
        <input type="number" name="trituration_cycle_id">

        <label>ID Cozimento (opcional):</label>
        <input type="number" name="cooking_cycle_id">

        <label>Toneladas Descarregadas:</label>
        <input type="number" name="toneladas_discarded">

        <label>Observações:</label>
        <textarea name="notes"></textarea>

        <button type="submit">Registrar Descarregamento</button>
    </form>
</div>
