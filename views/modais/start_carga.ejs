cat > views/modais/start_carga.ejs << 'EOF'
<!-- MODAL: Iniciar Carregamento -->
<div class="modal fade" id="modalStartCarga" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium">
      <div class="modal-body">
        <h4 class="title-premium">Iniciar Carregamento</h4>
        <p class="small-muted">Selecione a tova e informe a tonelagem para carregar o digestor.</p>

        <input type="hidden" id="start_digestor_id">

        <div class="mb-3">
          <label class="form-label">Tova</label>
          <select id="select_tova" class="form-select"></select>
        </div>

        <div class="mb-3">
          <label class="form-label">Toneladas solicitadas</label>
          <input id="ton_solicitadas" type="number" class="form-control" step="0.1" min="0">
        </div>

        <div class="d-flex justify-content-end gap-2">
          <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-premium" onclick="confirmStartCarga()">Confirmar</button>
        </div>
      </div>
    </div>
  </div>
</div>
EOF
