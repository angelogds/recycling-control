<div class="modal">
    <h2>Iniciar Trituração</h2>

    <form id="start-tritura-form">
        <label>Tova Origem:</label>
        <input type="number" name="from_tova_id" required>

        <label>Digestor:</label>
        <input type="number" name="digestor_id" required>

        <label>Toneladas Solicitadas:</label>
        <input type="number" name="toneladas_solicitadas" required>

        <button type="submit">Iniciar</button>
    </form>
</div>
