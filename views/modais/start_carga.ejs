<div class="modal fade" id="modalStartCarga" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Iniciar Trituração</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="formStartCarga">
                <div class="modal-body">
                    <input type="hidden" id="start_digestor_id">

                    <label class="form-label">Tova de Origem:</label>
                    <input type="number" class="form-control" id="start_tova_id" required>

                    <label class="form-label mt-2">Toneladas Solicitadas:</label>
                    <input type="number" class="form-control" id="start_ton" required>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-premium">Iniciar</button>
                </div>
            </form>
        </div>
    </div>
</div>
