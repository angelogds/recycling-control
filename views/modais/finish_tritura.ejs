<div class="modal fade" id="modalFinishTritura" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Finalizar Trituração</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="formFinishTritura">
                <div class="modal-body">
                    <input type="hidden" id="finish_tritura_id">

                    <label class="form-label">Toneladas Trituradas:</label>
                    <input type="number" class="form-control" id="finish_ton" required>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-premium">Finalizar</button>
                </div>
            </form>
        </div>
    </div>
</div>
