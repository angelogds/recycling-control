<div class="modal fade" id="modalFinishTritura" tabindex="-1">
  <div class="modal-dialog">
    <form id="formFinishTritura" class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Finalizar Trituração</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <input type="hidden" id="ft_trit_id" name="trituration_id">
        <div class="mb-3">
          <label>Toneladas Trituradas</label>
          <input id="ft_ton" name="toneladas_trituradas" class="form-control" type="number" step="0.1" required>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button><button class="btn btn-primary" type="submit">Finalizar</button></div>
    </form>
  </div>
</div>
