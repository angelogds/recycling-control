<%- include('layouts/base_top', { title: "Painel do Operador", usuario: usuario }) %>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #F2FFF9;
            font-family: 'Inter', Arial, sans-serif;
            color: #222;
        }

        .navbar-premium {
            background: #0AA06E !important;
        }

        .card-premium {
            border-radius: 14px;
            border: none;
            background: #FFFFFF;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        }

        .badge-status {
            background: #0AA06E;
            font-size: 12px;
            padding: 6px 10px;
        }

        .btn-premium {
            background: #0AA06E;
            color: #fff;
            border: none;
        }
        .btn-premium:hover {
            opacity: 0.9;
        }

        .btn-outline-premium {
            border: 1px solid #0AA06E;
            color: #0AA06E;
        }
        .btn-outline-premium:hover {
            background: #0AA06E;
            color: #fff;
        }

        .title-premium {
            color: #0AA06E;
            font-weight: 700;
        }
    </style>

</head>

<body>

<nav class="navbar navbar-premium navbar-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/">♻ CONTROLE DE PROCESSO</a>

        <span class="text-white fw-bold">
            <%= usuario ? usuario.nome : "" %>
        </span>
    </div>
</nav>

<div class="container mb-5">

<%- include('layouts/base_bottom') %>
