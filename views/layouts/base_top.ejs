<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || "Controle de Processo" %></title>

  <!-- Bootstrap (CSS) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<li class="nav-item">
    <a class="nav-link text-premium" href="/operador/historico">
        <i class="bi bi-clock-history me-2"></i> Histórico de Ciclos
    </a>
</li>

  <!-- App CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="app-header">
    <div class="brand">
      <img src="/img/logo_menu_256.png" alt="logo">
      <div>
        <div style="font-weight:700">Controle de Processo</div>
        <div style="font-size:12px; opacity:0.9">Fábrica de Reciclagem</div>
      </div>
    </div>

    <div class="user">
      <i class="bi bi-person-circle" style="font-size:20px; margin-right:8px;"></i>
      <span><%= usuario && usuario.nome ? usuario.nome : 'Operador' %></span>
    </div>
  </header>
