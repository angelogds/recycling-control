  <!-- container close (cada view fecha seu container) -->
  <!-- JS: Bootstrap (bundle) e Socket.io (client) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/theme.js"></script>

  <!-- helper global: mapping status -> classes -->
  <script>
    window.statusClass = function(status){
      if(!status) return 'status-idle';
      const s = String(status).toLowerCase();
      if(s.includes('idle') || s.includes('livre')) return 'status-idle';
      if(s.includes('tritura') || s.includes('tritur')) return 'status-triturando';
      if(s.includes('cook') || s.includes('cozinh') || s.includes('cozimento')) return 'status-cozinhando';
      if(s.includes('discharg') || s.includes('descarreg')) return 'status-discharging';
      if(s.includes('error') || s.includes('erro') || s.includes('fail')) return 'status-error';
      return 'status-idle';
    };
  </script>

</body>
</html>
