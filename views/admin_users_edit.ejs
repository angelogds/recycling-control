<!-- admin_users_edit.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Editar Usuário — Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div>Admin • Editar Usuário</div>
    <div><a href="/admin/users">Voltar</a></div>
  </div>

  <div class="container">
    <div class="card" style="max-width:600px; margin:auto;">
      <div class="card-title">Editar — <%= user.username %></div>

      <form method="POST" action="/admin/users/<%= user.id %>/update">
        <label>Nome</label>
        <input name="nome" value="<%= user.nome %>">
        <label>Role</label>
        <select name="role">
          <option value="operador" <%= user.role==='operador'?'selected':'' %>>Operador</option>
          <option value="portaria" <%= user.role==='portaria'?'selected':'' %>>Portaria</option>
          <option value="admin" <%= user.role==='admin'?'selected':'' %>>Admin</option>
        </select>
        <label>Nova senha (deixe em branco para manter)</label>
        <input name="password" type="password">

        <div style="margin-top:12px;">
          <button class="btn btn-green btn-full" type="submit">Salvar</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
