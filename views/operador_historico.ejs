<%- include('./layouts/base_top', { title: "Histórico de Ciclos", usuario: usuario }) %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <h2 class="title-premium">Histórico de Ciclos</h2>
  <div>
    <a href="/operador/painel" class="btn btn-outline-premium">Voltar ao Painel</a>
  </div>
</div>

<div class="card card-premium p-3 mb-4">
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label small">Digestor</label>
      <select id="filterDigestor" class="form-select">
        <option value="">Todos</option>
      </select>
    </div>

    <div class="col-md-3">
      <label class="form-label small">Período início</label>
      <input id="filterFrom" type="date" class="form-control">
    </div>

    <div class="col-md-3">
      <label class="form-label small">Período fim</label>
      <input id="filterTo" type="date" class="form-control">
    </div>

    <div class="col-md-2 d-flex align-items-end gap-2">
      <button id="btnApply" class="btn btn-premium w-100">Aplicar</button>
      <button id="btnReset" class="btn btn-outline-premium w-100">Limpar</button>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <div class="small text-muted">Resultados: <span id="resultCount">0</span></div>
  <div class="d-flex gap-2">
    <button id="btnExport" class="btn btn-sm btn-outline-premium">Exportar CSV</button>
    <button id="btnRefresh" class="btn btn-sm btn-premium">Atualizar</button>
  </div>
</div>

<div class="card card-premium p-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th style="width:80px">#</th>
          <th>Digestor</th>
          <th>Início</th>
          <th>Fim</th>
          <th>Trituração (in/out/tn)</th>
          <th>Cozimento (in/out)</th>
          <th>Descarga (tn)</th>
          <th style="width:220px">Ações</th>
        </tr>
      </thead>
      <tbody id="cyclesBody">
        <tr><td colspan="8" class="p-4 text-center text-muted">Carregando...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<nav class="mt-3 d-flex justify-content-between align-items-center">
  <div class="small text-muted">Page <span id="pageNum">1</span></div>
  <div>
    <button id="prevPage" class="btn btn-sm btn-outline-premium me-2">Anterior</button>
    <button id="nextPage" class="btn btn-sm btn-outline-premium">Próxima</button>
  </div>
</nav>

<!-- Modal: detalhes do ciclo -->
<div class="modal fade" id="cycleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Detalhes do Ciclo <span id="modalCycleId"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div id="modalContent">
          <p class="text-muted">Carregando...</p>
        </div>
      </div>
      <div class="modal-footer">
        <a id="modalPdfLink" class="btn btn-sm btn-premium" target="_blank">Gerar PDF</a>
        <button type="button" class="btn btn-sm btn-outline-premium" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<script>
/* Premium histórico - JS */
let currentPage = 1;
const pageSize = 10;
let currentRows = [];
let totalRows = 0;

const elDigestor = document.getElementById('filterDigestor');
const elFrom = document.getElementById('filterFrom');
const elTo = document.getElementById('filterTo');
const elBody = document.getElementById('cyclesBody');
const elResultCount = document.getElementById('resultCount');
const elPageNum = document.getElementById('pageNum');

document.getElementById('btnApply').addEventListener('click', () => { currentPage = 1; loadCycles(); });
document.getElementById('btnReset').addEventListener('click', () => { elDigestor.value = ''; elFrom.value = ''; elTo.value = ''; currentPage = 1; loadCycles(); });
document.getElementById('btnRefresh').addEventListener('click', () => loadCycles());
document.getElementById('btnExport').addEventListener('click', exportCSV);
document.getElementById('prevPage').addEventListener('click', () => { if (currentPage>1){ currentPage--; renderTablePage(); }});
document.getElementById('nextPage').addEventListener('click', () => { if ((currentPage*pageSize) < totalRows){ currentPage++; renderTablePage(); }});

const cycleModal = new bootstrap.Modal(document.getElementById('cycleModal'), {});

// carregar lista de digestores para filtro
async function loadDigestors(){
  try {
    const d = await fetch('/api/digestors').then(r=>r.json());
    elDigestor.innerHTML = '<option value="">Todos</option>';
    d.forEach(x => {
      const opt = document.createElement('option');
      opt.value = x.id;
      opt.textContent = x.nome;
      elDigestor.appendChild(opt);
    });
  } catch(e){
    console.error('Erro digestors', e);
  }
}

// carregar ciclos (fetch API)
async function loadCycles(){
  try {
    const q = new URLSearchParams();
    const digestor = elDigestor.value;
    if (digestor) q.set('digestor_id', digestor);
    q.set('limit', 1000); // obter bastante resultados (paginamos no cliente)

    const rows = await fetch('/api/cycles?' + q.toString()).then(r => {
      if (!r.ok) throw new Error('Falha ao buscar ciclos');
      return r.json();
    });

    // aplicar filtros de data no cliente se fornecidos
    let filtered = rows || [];
    const from = elFrom.value ? new Date(elFrom.value) : null;
    const to = elTo.value ? new Date(elTo.value) : null;
    if (from || to){
      filtered = filtered.filter(r => {
        const started = r.started_at ? new Date(r.started_at) : null;
        if (from && started && started < from) return false;
        if (to && started && started > new Date(new Date(to).setDate(to.getDate()+1))) return false;
        return true;
      });
    }

    currentRows = filtered;
    totalRows = currentRows.length;
    elResultCount.textContent = totalRows;
    currentPage = 1;
    renderTablePage();
  } catch (err){
    console.error(err);
    elBody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-danger">Erro carregando histórico.</td></tr>';
  }
}

function renderTablePage(){
  const start = (currentPage-1)*pageSize;
  const pageRows = currentRows.slice(start, start+pageSize);
  elBody.innerHTML = '';

  if (pageRows.length === 0){
    elBody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-muted">Nenhum ciclo encontrado.</td></tr>';
    elPageNum.textContent = currentPage;
    return;
  }

  pageRows.forEach(r => {
    const tr = document.createElement('tr');

    const tdId = document.createElement('td');
    tdId.innerHTML = '<strong>#' + r.id + '</strong>';
    tr.appendChild(tdId);

    const tdDigest = document.createElement('td');
    tdDigest.textContent = r.digestor_nome || ('Digestor ' + (r.digestor_id || '—'));
    tr.appendChild(tdDigest);

    const tdStart = document.createElement('td');
    tdStart.textContent = r.started_at ? new Date(r.started_at).toLocaleString() : '—';
    tr.appendChild(tdStart);

    const tdEnd = document.createElement('td');
    tdEnd.textContent = r.ended_at ? new Date(r.ended_at).toLocaleString() : '—';
    tr.appendChild(tdEnd);

    const tdTrit = document.createElement('td');
    tdTrit.innerHTML = '<small class="text-muted">ini: ' + (r.start_tritura_at? new Date(r.start_tritura_at).toLocaleString():'—') +
                        '</small><br><small class="text-muted">fim: ' + (r.end_tritura_at? new Date(r.end_tritura_at).toLocaleString():'—') +
                        '</small><br><strong>' + (r.toneladas_trituradas || '—') + ' tn</strong>';
    tr.appendChild(tdTrit);

    const tdCook = document.createElement('td');
    tdCook.innerHTML = '<small class="text-muted">ini: ' + (r.start_cook_at? new Date(r.start_cook_at).toLocaleString():'—') +
                        '</small><br><small class="text-muted">fim: ' + (r.end_cook_at? new Date(r.end_cook_at).toLocaleString():'—') + '</small>';
    tr.appendChild(tdCook);

    const tdDisc = document.createElement('td');
    tdDisc.textContent = r.toneladas_discarded ? r.toneladas_discarded + ' tn' : '—';
    tr.appendChild(tdDisc);

    const tdActions = document.createElement('td');
    tdActions.className = 'd-flex gap-2';

    const btnDetails = document.createElement('button');
    btnDetails.className = 'btn btn-sm btn-outline-premium';
    btnDetails.textContent = 'Detalhes';
    btnDetails.addEventListener('click', () => openDetails(r));
    tdActions.appendChild(btnDetails);

    const btnPdf = document.createElement('button');
    btnPdf.className = 'btn btn-sm btn-premium';
    btnPdf.textContent = 'Gerar PDF';
    btnPdf.addEventListener('click', () => generatePdf(r.id));
    tdActions.appendChild(btnPdf);

    tdActions.innerHTML += '&nbsp;';
    tr.appendChild(tdActions);

    elBody.appendChild(tr);
  });

  elPageNum.textContent = currentPage;
}

/* abrir modal com detalhes */
function openDetails(r){
  document.getElementById('modalCycleId').textContent = '#' + r.id;
  const content = document.getElementById('modalContent');
  content.innerHTML = `
    <div class="row">
      <div class="col-md-6">
        <p><strong>Digestor:</strong> ${r.digestor_nome || r.digestor_id}</p>
        <p><strong>Início do ciclo:</strong> ${r.started_at ? new Date(r.started_at).toLocaleString() : '—'}</p>
        <p><strong>Fim do ciclo:</strong> ${r.ended_at ? new Date(r.ended_at).toLocaleString() : '—'}</p>
      </div>
      <div class="col-md-6">
        <p><strong>Trituração início:</strong> ${r.start_tritura_at? new Date(r.start_tritura_at).toLocaleString() : '—'}</p>
        <p><strong>Trituração fim:</strong> ${r.end_tritura_at? new Date(r.end_tritura_at).toLocaleString() : '—'}</p>
        <p><strong>Toneladas trituradas:</strong> ${r.toneladas_trituradas || '—'}</p>
        <p><strong>Descarga (tn):</strong> ${r.toneladas_discarded || '—'}</p>
      </div>
    </div>
    <hr>
    <div><strong>Notas:</strong><br>${r.notes ? (r.notes.replace(/\n/g,'<br>')) : '<span class="text-muted">Sem notas</span>'}</div>
  `;
  const pdfLink = document.getElementById('modalPdfLink');
  pdfLink.href = '#';
  pdfLink.onclick = (e) => { e.preventDefault(); generatePdf(r.id); };

  cycleModal.show();
}

/* Gerar PDF - tenta a rota /reports/cycle/:id que retorna {url: "/reports/..." } */
async function generatePdf(id){
  try {
    const resp = await fetch('/reports/cycle/' + id);
    if (!resp.ok) {
      const txt = await resp.text().catch(()=>null);
      console.warn('PDF generation failed', txt);
      alert('Não foi possível gerar PDF (ver logs)');
      return;
    }
    const js = await resp.json();
    if (js && js.url) {
      window.open(js.url, '_blank');
    } else {
      alert('PDF gerado, mas resposta inesperada do servidor.');
    }
  } catch(e){
    console.error('Erro gerar PDF', e);
    alert('Erro ao solicitar PDF (ver logs).');
  }
}

/* Export CSV das linhas atuais */
function exportCSV(){
  if (!currentRows || currentRows.length === 0) { alert('Nenhum registro para exportar.'); return; }

  const headers = ['id','digestor','started_at','ended_at','tritura_ini','tritura_fim','tn_trituradas','cook_ini','cook_fim','toneladas_discarded','notes'];
  const lines = [headers.join(',')];

  currentRows.forEach(r => {
    const row = [
      r.id,
      `"${(r.digestor_nome||r.digestor_id||'').toString().replace(/"/g,'""')}"`,
      r.started_at || '',
      r.ended_at || '',
      r.start_tritura_at || '',
      r.end_tritura_at || '',
      r.toneladas_trituradas || '',
      r.start_cook_at || '',
      r.end_cook_at || '',
      r.toneladas_discarded || '',
      `"${(r.notes||'').toString().replace(/"/g,'""')}"`
    ];
    lines.push(row.join(','));
  });

  const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `historico_ciclos_${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

/* init */
(async function init(){
  await loadDigestors();
  await loadCycles();

  // reconectar via socket para updates em tempo real (opcional)
  try {
    const s = io();
    s.on('digestors:update', () => { loadCycles(); }); // quando digestores mudarem, recarrega histórico (simples)
  } catch(e){}
})();
</script>

<%- include('./layouts/base_bottom') %>
