<%- include("layouts/base_top", { title: "Histórico de Ciclos" }) %>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="bi bi-clock-history me-2"></i> Histórico de Ciclos
        </h1>

        <a href="/operador/painel" class="btn btn-premium">
            ← Voltar ao Painel
        </a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Digestor</th>
                <th>Início</th>
                <th>Fim</th>
                <th>Status</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>

        <tbody id="cyclesTableBody">
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    Nenhum ciclo registrado.
                </td>
            </tr>
        </tbody>
    </table>

</div>

<%- include("modais/detalhes_ciclo") %>

<script>
async function carregarHistorico() {
    const res = await fetch('/api/cycles/all');
    const lista = await res.json();

    const tbody = document.getElementById("cyclesTableBody");
    tbody.innerHTML = "";

    if (lista.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    Nenhum ciclo registrado.
                </td>
            </tr>`;
        return;
    }

    lista.forEach(c => {
        tbody.innerHTML += `
            <tr>
                <td>${c.id}</td>
                <td>Digestor ${c.digestor_id}</td>
                <td>${c.start_time || "-"}</td>
                <td>${c.end_time || "-"}</td>
                <td><span class="badge bg-${
                    c.status === "in_progress" ? "warning" : "success"
                }">${c.status}</span></td>
                <td class="text-center">
                    <button class="btn btn-premium btn-sm" onclick="abrirDetalhes(${c.id})">
                        Ver Detalhes
                    </button>
                </td>
            </tr>`;
    });
}

async function abrirDetalhes(id) {
    const res = await fetch(`/api/cycles/${id}`);
    const ciclo = await res.json();

    document.getElementById("dc_id").innerText = ciclo.id;
    document.getElementById("dc_digestor").innerText = ciclo.digestor_id;
    document.getElementById("dc_inicio").innerText = ciclo.started_at;
    document.getElementById("dc_fim").innerText = ciclo.ended_at || "—";

    new bootstrap.Modal(document.getElementById("modalDetalhesCiclo")).show();
}

carregarHistorico();
</script>

<%- include("layouts/base_bottom") %>
