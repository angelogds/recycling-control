<%- include("layouts/base_top", { title: "Histórico de Ciclos" }) %>

<div class="container mt-4">

    <a href="/operador/painel"
       class="btn btn-premium mb-3"
       style="font-size:14px;">
       ← Voltar ao Painel do Operador
    </a>

    <h1 class="page-title mb-4">
        <i class="bi bi-clock-history me-2"></i>
        Histórico de Ciclos
    </h1>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Digestor</th>
                <th>Início</th>
                <th>Fim</th>
                <th>Status</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>

        <tbody id="cyclesTableBody">
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    Carregando histórico...
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal Detalhes -->
<div class="modal fade" id="modalDetalhes" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Detalhes do Ciclo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <div class="row mb-2">
            <div class="col-6"><strong>ID:</strong> <span id="det-id"></span></div>
            <div class="col-6"><strong>Digestor:</strong> <span id="det-digestor"></span></div>
        </div>

        <div class="row mb-2">
            <div class="col-6"><strong>Início:</strong> <span id="det-start"></span></div>
            <div class="col-6"><strong>Fim:</strong> <span id="det-end"></span></div>
        </div>

        <hr>

        <h6 class="text-premium"><strong>Trituração</strong></h6>
        <div class="row mb-2">
            <div class="col-6">Início: <span id="det-trit-start"></span></div>
            <div class="col-6">Fim: <span id="det-trit-end"></span></div>
            <div class="col-12">Toneladas: <span id="det-trit-ton"></span></div>
        </div>

        <h6 class="text-premium"><strong>Cozimento</strong></h6>
        <div class="row mb-2">
            <div class="col-6">Início: <span id="det-cook-start"></span></div>
            <div class="col-6">Fim: <span id="det-cook-end"></span></div>
        </div>

        <h6 class="text-premium"><strong>Descarregamento</strong></h6>
        <div class="row mb-2">
            <div class="col-6">Toneladas: <span id="det-disc-ton"></span></div>
            <div class="col-6">Notas: <span id="det-disc-notes"></span></div>
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn btn-premium" data-bs-dismiss="modal">Fechar</button>
      </div>

    </div>
  </div>
</div>

<script>
async function loadCycles() {
    const res = await fetch('/api/cycles/all');
    const lista = await res.json();

    const tbody = document.getElementById("cyclesTableBody");
    tbody.innerHTML = "";

    if (!lista.length) {
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center text-muted py-4">Nenhum ciclo encontrado.</td>
            </tr>`;
        return;
    }

    lista.forEach(c => {
        tbody.innerHTML += `
            <tr>
                <td>${c.id}</td>
                <td>${c.digestor_name || "—"}</td>
                <td>${c.started_at || "—"}</td>
                <td>${c.ended_at || "—"}</td>
                <td><span class="badge bg-${c.status === "finished" ? "success" : "warning"}">${c.status}</span></td>
                <td class="text-center">
                    <button class="btn btn-premium btn-sm" onclick="ver(${c.id})">
                        Ver Detalhes
                    </button>
                </td>
            </tr>`;
    });
}

async function ver(id) {
    const r = await fetch(`/api/cycles/${id}`);
    const c = await r.json();
    if (!r.ok) return alert("Erro carregando ciclo.");

    document.getElementById("det-id").innerText = c.id;
    document.getElementById("det-digestor").innerText = c.digestor_name;
    document.getElementById("det-start").innerText = c.started_at || "—";
    document.getElementById("det-end").innerText = c.ended_at || "—";

    document.getElementById("det-trit-start").innerText = c.start_tritura_at || "—";
    document.getElementById("det-trit-end").innerText = c.end_tritura_at || "—";
    document.getElementById("det-trit-ton").innerText = c.toneladas_trituradas || "—";

    document.getElementById("det-cook-start").innerText = c.start_cook_at || "—";
    document.getElementById("det-cook-end").innerText = c.end_cook_at || "—";

    document.getElementById("det-disc-ton").innerText = c.toneladas_discarded || "—";
    document.getElementById("det-disc-notes").innerText = c.notes || "—";

    new bootstrap.Modal(document.getElementById("modalDetalhes")).show();
}

loadCycles();
</script>

<%- include("layouts/base_bottom") %>
