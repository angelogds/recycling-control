<%- include('layouts/base_top', { title: title, usuario: usuario }) %>

<h2><%= title %></h2>

<table class="table">
  <thead><tr><th>ID</th><th>Digestor</th><th>Toneladas</th><th>Operador</th><th>Data</th></tr></thead>
  <tbody>
    <% historico.forEach(h => { %>
      <tr>
        <td><%= h.id %></td>
        <td><%= h.digestor_id %></td>
        <td><%= h.toneladas_discarded %></td>
        <td><%= h.operator_id %></td>
        <td><%= h.created_at %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('layouts/base_bottom') %>
