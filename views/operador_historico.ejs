<%- include('layouts/base_top', { title: "Histórico de Ciclos" }) %>

<div class="container mt-4">

    <h1 class="page-title mb-4">
        <i class="bi bi-clock-history me-2"></i>
        Histórico de Ciclos
    </h1>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Digestor</th>
                <th>Início</th>
                <th>Fim</th>
                <th>Status</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>

        <tbody id="cyclesTableBody">
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    Nenhum ciclo registrado.
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal de Detalhes do Ciclo -->
<%- include('modais/detalhes_ciclo') %>

<script>
// ---------------------------------------------------------
// Formata datas no padrão brasileiro
// ---------------------------------------------------------
function formatarData(dt) {
    if (!dt) return "—";
    try {
        return new Date(dt).toLocaleString("pt-BR");
    } catch {
        return dt;
    }
}

// ---------------------------------------------------------
// Carrega histórico na tabela
// ---------------------------------------------------------
async function carregarHistorico() {
    const res = await fetch('/api/cycles/all');
    const lista = await res.json();

    const tbody = document.getElementById("cyclesTableBody");
    tbody.innerHTML = "";

    if (lista.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    Nenhum ciclo registrado.
                </td>
            </tr>`;
        return;
    }

    lista.forEach(c => {
        const statusCor =
            c.status === "in_progress" ? "warning" :
            c.status === "finalizado" ? "success" :
            "secondary";

        tbody.innerHTML += `
            <tr>
                <td>${c.id}</td>
                <td>Digestor ${c.digestor_id}</td>
                <td>${formatarData(c.start_cycle_at)}</td>
                <td>${formatarData(c.end_cycle_at)}</td>

                <td>
                    <span class="badge bg-${statusCor} text-uppercase">
                        ${c.status}
                    </span>
                </td>

                <td class="text-center">

                    <!-- Botão Ver Detalhes -->
                    <button class="btn btn-primary btn-sm me-1"
                            onclick="abrirDetalhes(${c.id})">
                        <i class="bi bi-search"></i> Ver
                    </button>

                    <!-- Botão PDF (somente para finalizados) -->
                    ${
                        c.status === "finalizado"
                        ? `<a href="/pdf/ciclo/${c.id}" class="btn btn-success btn-sm">
                                <i class="bi bi-filetype-pdf"></i> PDF
                           </a>`
                        : `<span class="text-muted small">—</span>`
                    }

                </td>
            </tr>
        `;
    });
}

// ---------------------------------------------------------
// Abre modal com detalhes
// ---------------------------------------------------------
async function abrirDetalhes(id) {
    const res = await fetch(`/api/cycles/${id}`);
    const ciclo = await res.json();

    document.getElementById("dc_id").innerText = ciclo.id;
    document.getElementById("dc_digestor").innerText = ciclo.digestor_id;
    document.getElementById("dc_inicio").innerText = formatarData(ciclo.start_cycle_at);
    document.getElementById("dc_fim").innerText = formatarData(ciclo.end_cycle_at);

    document.getElementById("dc_tritura").innerText =
        ciclo.trit ? ciclo.trit.toneladas_trituradas + " tn" : "—";

    document.getElementById("dc_cook").innerText =
        ciclo.cook ? ciclo.cook.status : "—";

    document.getElementById("dc_descarga").innerText =
        ciclo.discharge ? ciclo.discharge.toneladas_discarded + " tn" : "—";

    new bootstrap.Modal(document.getElementById("modalDetalhesCiclo")).show();
}

carregarHistorico();
</script>

<%- include('layouts/base_bottom') %>
