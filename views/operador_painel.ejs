<% layout('layouts/main') %>

<h1>Painel do Operador</h1>

<h3>Log do sistema:</h3>
<p style="color:#555;">Aguardando eventos...</p>

<div id="log-box" style="padding:10px; background:#f2f2f2; border-radius:6px; font-family:monospace; height:250px; overflow-y:auto;">
</div>

<script>
const socket = io();

socket.on("connect", () => {
    document.getElementById("log-box").innerHTML += "<p>Socket conectado...</p>";
});

socket.on("digestors:update", data => {
    document.getElementById("log-box").innerHTML += "<p>Atualização de digestores recebida.</p>";
});

socket.on("tovas:update", data => {
    document.getElementById("log-box").innerHTML += "<p>Atualização de tovas recebida.</p>";
});

socket.on("entries:update", data => {
    document.getElementById("log-box").innerHTML += "<p>Atualização de entradas recebida.</p>";
});
</script>
