<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Painel do Operador — Campo do Gado</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #eef2f6;
            font-family: Arial, sans-serif;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            padding: 18px 25px;
            background: #0C69F6;
            color: #fff;
            align-items: center;
        }

        .top-bar h2 {
            margin: 0;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 22px;
            padding: 25px;
        }

        .digestor-card {
            background: #fff;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0 4px 12px #0001;
            border-left: 6px solid #2a2a2a;
        }

        .digestor-card h3 {
            margin-top: 0;
            font-size: 20px;
            color: #222;
        }

        .status-pill {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 22px;
            font-size: 12px;
            font-weight: bold;
            color: #fff;
            margin-bottom: 10px;
        }

        .idle { background: #777; }
        .operating { background: #0C69F6; }
        .cooking { background: #f79600; }
        .waiting_discharge { background: #d62c2c; }

        .btn {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: none;
            margin-top: 10px;
            font-weight: bold;
            cursor: pointer;
            font-size: 15px;
            transition: .15s;
        }

        .btn-start { background: #0C69F6; color: #fff; }
        .btn-end { background: #ff8c00; color: #fff; }
        .btn-discharge { background: #d62c2c; color: #fff; }
        .btn-disabled {
            background: #ccc !important;
            color: #666 !important;
            cursor: not-allowed;
        }

        .timer {
            font-size: 22px;
            font-weight: bold;
            margin-top: 15px;
            color: #333;
        }

    </style>
</head>

<body>

    <div class="top-bar">
        <h2>Operador: <%= usuario.nome %></h2>
        <a href="/logout" style="color:#fff; font-weight:bold;">Sair</a>
    </div>

    <div class="grid">

        <% digestores.forEach(d => { %>
            <div class="digestor-card" id="digestor-<%= d.id %>">

                <h3><%= d.nome %></h3>

                <div class="status-pill <%= d.status %>">
                    <%= d.status.replace("_", " ").toUpperCase() %>
                </div>

                <div class="timer" id="timer-<%= d.id %>">
                    00:00:00
                </div>

                <!-- Botões inteligentes controlados por operador.js -->
                <button 
                    class="btn btn-start" 
                    onclick="openStartModal(<%= d.id %>)"
                    id="btn-start-<%= d.id %>">
                    Iniciar Trituração
                </button>

                <button 
                    class="btn btn-end" 
                    onclick="finishTritura(<%= d.id %>)"
                    id="btn-finish-<%= d.id %>">
                    Finalizar Trituração
                </button>

                <button 
                    class="btn btn-end" 
                    onclick="finishCooking(<%= d.id %>)"
                    id="btn-finish-cook-<%= d.id %>">
                    Finalizar Cozimento
                </button>

                <button 
                    class="btn btn-discharge" 
                    onclick="openDischargeModal(<%= d.id %>)"
                    id="btn-discharge-<%= d.id %>">
                    Descarregar Digestor
                </button>
            </div>
        <% }) %>

    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/operador.js"></script>

</body>
</html>
