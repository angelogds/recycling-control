div.innerHTML = `
    <h4>${d.nome}</h4>
    <div class="muted">Capacidade: ${d.capacidade_tn} tn</div>

    <!-- Barra de progresso dinâmica -->
    <div class="progress mt-2" style="height: 18px; border-radius: 10px;">
        <div id="bar-${d.id}"
             class="progress-bar progress-bar-striped progress-bar-animated"
             role="progressbar"
             style="width: 0%; background:#1e6d36;">
             0%
        </div>
    </div>

    <div class="small">
      <div><strong>Trituração:</strong> ${d.current_tritura ? ('#' + d.current_tritura.id) : 'Nenhuma'}</div>
      <div><strong>Cozimento:</strong> ${d.current_cooking ? ('#' + d.current_cooking.id) : 'Nenhuma'}</div>
      <div><strong>Ciclo:</strong> ${d.current_cycle ? ('#' + d.current_cycle.id) : 'Nenhum'}</div>
    </div>

    <div class="mt-3 gap-2">
      <button class="btn-premium" onclick="startCarga(${d.id})"><i class="bi bi-truck-loading"></i> Iniciar Carregamento</button>
      <button class="btn-outline-premium" onclick="finishTrit(${d.current_tritura ? d.current_tritura.id : 'null'})"><i class="bi bi-hammer"></i> Finalizar Trituração</button>
      <button class="btn-outline-premium" onclick="finishCook(${d.current_cooking ? d.current_cooking.id : 'null'})"><i class="bi bi-thermometer-high"></i> Finalizar Cozimento</button>
      <button class="btn-warning" onclick="discharge(${d.id}, ${d.current_tritura ? d.current_tritura.id : 'null'}, ${d.current_cooking ? d.current_cooking.id : 'null'})"><i class="bi bi-box-arrow-in-down"></i> Descarregar</button>
    </div>
`;

// Atualiza percentual da barra
let pct = 0;
if (d.current_tritura) pct = 40;
if (d.current_cooking) pct = 75;
if (d.current_cycle) pct = 100;

const bar = div.querySelector(`#bar-${d.id}`);
if (bar) {
    bar.style.width = pct + "%";
    bar.innerText = pct + "%";
}
