<table class="table table-bordered table-striped digestor-table mt-4 shadow-sm">
    <thead class="table-success">
        <tr>
            <th>Digestor</th>
            <th>Capacidade</th>
            <th>Status</th>
            <th>Barra de Progresso</th>
            <th>Trituração</th>
            <th>Cozimento</th>
            <th>Ciclo</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>

    <tbody id="digestoresTableBody">
        <% digestores.forEach(d => { %>
            <tr id="row-<%= d.id %>">

                <!-- Nome -->
                <td><strong><%= d.nome %></strong></td>

                <!-- Capacidade -->
                <td><%= d.capacidade_tn %> tn</td>

                <!-- Status -->
                <td>
                    <span id="status-<%= d.id %>"
                          class="badge bg-success status-pill">
                        IDLE
                    </span>
                </td>

                <!-- BAR -->
                <td style="width: 280px;">
                    <div class="progress" style="height: 20px;">
                        <div id="bar-<%= d.id %>"
                             class="progress-bar bg-success"
                             role="progressbar"
                             style="width: 0%;">
                            0%
                        </div>
                    </div>
                </td>

                <!-- Trituração -->
                <td id="tritura-<%= d.id %>">Nenhuma</td>

                <!-- Cozimento -->
                <td id="cozimento-<%= d.id %>">Nenhum</td>

                <!-- Ciclo -->
                <td id="ciclo-<%= d.id %>">Nenhum</td>

                <!-- AÇÕES -->
                <td class="text-center">
                    <button class="btn btn-success btn-sm" onclick="openStartCarga(<%= d.id %>)">
                        <i class="bi bi-play-fill"></i> Iniciar
                    </button>

                    <button class="btn btn-primary btn-sm" onclick="openFinishTritura(<%= d.id %>)">
                        <i class="bi bi-check-lg"></i> Finalizar Tritura
                    </button>

                    <button class="btn btn-info btn-sm" onclick="openFinishCook(<%= d.id %>)">
                        <i class="bi bi-fire"></i> Finalizar Cozimento
                    </button>

                    <button class="btn btn-warning btn-sm" onclick="openDischarge(<%= d.id %>)">
                        <i class="bi bi-truck"></i> Descarregar
                    </button>
                </td>

            </tr>
        <% }) %>
    </tbody>
</table>
