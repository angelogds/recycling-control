<%- include('layouts/base_top', { title: "Painel do Operador", usuario: usuario }) %>

<div class="container">
  <h1 class="page-title">Painel do Operador</h1>

  <div id="digestorGrid" class="dg-grid"></div>

  <div class="log-card">
    <strong>Log do sistema:</strong>
    <div id="logContent" class="mt-2 text-muted">Aguardando eventos...</div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/operador.js"></script>

<style>
/* ========================================================= */
/* ESTILO PREMIUM DO PAINEL DO OPERADOR                      */
/* ========================================================= */

.dg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 25px;
}

/* cartão principal */
.digestor-card {
    background: #fff;
    border-radius: 12px;
    padding: 18px 22px;
    box-shadow: 0px 3px 8px rgba(0,0,0,0.15);
    border-left: 6px solid #166534;
}

.dg-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dg-header h3 {
    margin: 0;
    font-weight: 700;
    font-size: 20px;
}

.dg-status {
    font-size: 15px;
    font-weight: bold;
}

.dg-row {
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 16px;
}

/* Matéria-prima seletores */
.materia-select {
    margin-top: 12px;
    display: flex;
    gap: 10px;
    align-items: center;
}

.materia-select label {
    font-weight: bold;
}

.mat-btn {
    padding: 6px 14px;
    border-radius: 8px;
    cursor: pointer;
    background: #e5e5e5;
    border: 1px solid #ccc;
}

.mat-btn.selected {
    background: #15803d;
    color: #fff;
    border-color: #14532d;
}

/* Botões */
.dg-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.dg-actions button {
    flex: 1;
    padding: 10px 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: 0.2s;
}

/* Inativo */
.dg-actions button.disabled {
    opacity: 0.4;
    background: #cbd5e1;
    cursor: not-allowed;
}

/* Ativo */
.dg-actions button.active {
    background: #16a34a;
    color: white;
}

.dg-actions button.active:hover {
    background: #15803d;
}

/* Descarregar */
.btn-discharge.active {
    background: #eab308 !important;
    color: black !important;
}

.btn-discharge.active:hover {
    background: #ca8a04 !important;
}

/* Log */
.log-card {
    margin-top: 30px;
    background: #fff;
    padding: 18px 22px;
    border-radius: 10px;
    box-shadow: 0px 2px 5px rgba(0,0,0,0.15);
}
</style>
