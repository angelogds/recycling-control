<%- include('layouts/base_top', { title: "Painel do Operador", usuario: usuario }) %>

<h2 class="mb-4 title-premium">Painel do Operador</h2>

<div class="row g-4 mb-4" id="digestorGrid">
    <!-- Preenchido via operador.js -->
</div>

<div id="log" class="card card-premium p-3">
    <strong class="title-premium">Log do sistema:</strong>
    <div id="logContent" class="mt-2 small text-muted">Aguardando eventos...</div>
</div>

<script src="/js/operador.js"></script>
<!-- MODAL — INICIAR CARREGAMENTO -->
<div class="modal fade" id="modalStartCarga" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium p-3">
      
      <h4 class="title-premium mb-2">Iniciar Carregamento</h4>
      <p class="text-muted small">Selecione a tova e informe a tonelagem desejada.</p>

      <input type="hidden" id="start_digestor_id">

      <div class="mb-3">
        <label class="form-label fw-bold">Selecionar Tova</label>
        <select id="select_tova" class="form-select">
          <!-- preenchido via JS -->
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Toneladas solicitadas</label>
        <input type="number" id="ton_solicitadas" class="form-control" min="0" step="0.1">
      </div>

      <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-premium" onclick="confirmStartCarga()">Confirmar</button>
      </div>

    </div>
  </div>
</div>

<%- include('layouts/base_bottom') %>
