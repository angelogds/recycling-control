<%- include('layouts/base_top', { title: "Painel do Operador" }) %>

<div class="container mt-4">
  <h1 class="page-title"><i class="bi bi-speedometer2 me-2"></i> Painel do Operador</h1>

  <table class="table table-striped digestor-table shadow-sm">
    <thead>
      <tr>
        <th>Digestor</th>
        <th>Matéria-prima</th>
        <th>Status</th>
        <th>Tempo (Trit. / Coz.)</th>
        <th>Últimos Tempos</th>
        <th class="text-center">Ações</th>
      </tr>
    </thead>
    <tbody id="digestoresTableBody">
      <!-- Rows serão renderizadas via JS -->
    </tbody>
  </table>

  <div class="log-card">
    <strong>Log do sistema:</strong>
    <div id="logContent" class="mt-2 text-muted">Aguardando eventos...</div>
  </div>
</div>

<!-- Modais (4 premium) -->
<%- include('modais/trituracao_start') %>
<%- include('modais/trituracao_finish') %>
<%- include('modais/cozimento_finish') %>
<%- include('modais/discharge') %>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/operador.js"></script>

<%- include('layouts/base_bottom') %>
