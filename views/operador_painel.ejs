cat > views/operador_painel.ejs << 'EOF'
<%- include("layouts/base_top", { title: "Painel do Operador", usuario: usuario }) %>

<h2 class="title-premium mb-4">Painel do Operador</h2>

<div class="row g-4" id="digestorGrid">
    <!-- preenchido pelo JS -->
</div>

<!-- LOG -->
<div class="card card-premium p-3 mt-4">
    <strong class="title-premium">Log do sistema:</strong>
    <div id="logContent" class="mt-2 text-muted small">Aguardando eventos...</div>
</div>

<!-- MODAL: Iniciar Carregamento -->
<div class="modal fade" id="modalStartCarga" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium p-3">
      <h4 class="title-premium mb-2">Iniciar Carregamento</h4>
      <p class="text-muted small">Selecione a tova e a tonelagem desejada.</p>
      <input type="hidden" id="start_digestor_id">
      <div class="mb-3">
        <label class="form-label fw-bold">Tova</label>
        <select id="select_tova" class="form-select"></select>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Toneladas desejadas</label>
        <input type="number" class="form-control" id="ton_solicitadas" min="0" step="0.1">
      </div>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-premium" onclick="confirmStartCarga()">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL — FINALIZAR TRITURAÇÃO -->
<div class="modal fade" id="modalFinishTrit" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium p-3">
      <h4 class="title-premium mb-2">Finalizar Trituração</h4>
      <input type="hidden" id="finish_trit_id">
      <div class="mb-3">
        <label class="form-label fw-bold">Toneladas trituradas</label>
        <input id="ton_trituradas" type="number" class="form-control" min="0" step="0.1">
      </div>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-premium" onclick="confirmFinishTrit()">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL — FINALIZAR COZIMENTO -->
<div class="modal fade" id="modalFinishCook" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium p-3">
      <h4 class="title-premium mb-2">Finalizar Cozimento</h4>
      <input type="hidden" id="finish_cook_id">
      <div class="mb-3">
        <label class="form-label fw-bold">Observações (opcional)</label>
        <textarea id="cook_notes" class="form-control" rows="3"></textarea>
      </div>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-premium" onclick="confirmFinishCook()">Finalizar Cozimento</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL — DESCARREGAR DIGESTOR -->
<div class="modal fade" id="modalDischarge" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium p-3">
      <h4 class="title-premium mb-2">Descarregar Digestor</h4>
      <input type="hidden" id="discharge_digestor_id">
      <input type="hidden" id="discharge_trit_id">
      <input type="hidden" id="discharge_cook_id">
      <div class="mb-3">
        <label class="form-label fw-bold">Toneladas descarregadas</label>
        <input id="ton_descarregadas" type="number" class="form-control" min="0" step="0.1">
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Observações</label>
        <textarea id="discharge_notes" class="form-control" rows="2"></textarea>
      </div>
      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-warning" onclick="confirmDischarge()">Descarregar</button>
      </div>
    </div>
  </div>
</div>

<%- include("layouts/base_bottom") %>
EOF
