<%- include("layouts/base_top", { title: "Painel do Operador", usuario: usuario }) %>

<link rel="stylesheet" href="/css/operador.css">

<div class="top-bar">
    <h1 class="page-title">Painel do Operador</h1>
    <a href="/operador/historico" class="btn-history">📄 Histórico</a>
</div>

<div id="digestorGrid" class="digestor-grid">

    <% digestores.forEach(d => { %>

    <div class="digestor-card" id="digestor-<%= d.id %>" data-id="<%= d.id %>">

        <div class="dg-header">
            <div class="dg-title">Digestor <%= d.id %></div>
            <div class="dg-status status-parado">Parado</div>
        </div>

        <!-- Materia prima -->
        <div class="materia-select">
            <div class="mat-label">Matéria-prima</div>
            <button class="mat-btn" data-mat="osso">Osso</button>
            <button class="mat-btn" data-mat="barrigada">Barrigada</button>
        </div>

        <!-- Inputs de ciclo -->
        <div class="ciclo-inputs">
            <div class="input-block">
                <label>Tova:</label>
                <select class="select-tova">
                    <option value="1">Tova 1</option>
                    <option value="2">Tova 2</option>
                </select>
            </div>

            <div class="input-block">
                <label>Toneladas:</label>
                <input type="number" step="0.1" class="input-ton" placeholder="0,0" />
            </div>
        </div>

        <!-- Timers -->
        <div class="timer-section">
            <div>
                <span class="timer-label">Trituração:</span>
                <span class="timer-tritura">--:--:--</span>
            </div>
            <div>
                <span class="timer-label">Cozimento:</span>
                <span class="timer-cook">--:--:--</span>
            </div>
        </div>

        <!-- Botões lado a lado -->
        <div class="action-buttons">
            <button class="btn-action btn-start">Iniciar Trituração</button>
            <button class="btn-action btn-finish-trit disabled">Finalizar Trituração</button>
            <button class="btn-action btn-finish-cook disabled">Finalizar Cozimento</button>
            <button class="btn-action btn-discharge disabled">Descarregar</button>
        </div>

    </div>

    <% }) %>

</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/operador.js"></script>

<%- include("layouts/base_bottom") %>
