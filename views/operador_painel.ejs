<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel do Operador</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="top-bar">
    <div>Operador: <%= usuario && usuario.nome ? usuario.nome : 'Usuário' %></div>
    <div style="display:flex; gap:12px;">
      <a href="/operador/historico">Histórico</a>
      <a href="/tovas">Tovas</a>
      <a href="/dashboard">Dashboard</a>
      <% if (usuario && usuario.role === 'admin') { %>
        <a href="/admin/reports">Relatórios</a>
        <a href="/admin/users">Configurações</a>
      <% } %>
      <a href="/logout">Sair</a>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Digestores — Estado Atual</div>

      <div class="row" id="digestorGrid">
        <% if (!digestores || digestores.length === 0) { %>
          <div class="col-12"><div class="alert">Nenhum digestor cadastrado.</div></div>
        <% } else { %>
          <% digestores.forEach(d => { %>
            <div class="col-4">
              <div class="digestor-box" data-id="<%= d.id %>">
                <h2 class="digestor-name"><%= d.nome %></h2>
                <p>Capacidade: <strong><%= d.capacidade_tn %> tn</strong></p>
                <p>Status: <span class="status-<%= d.status === 'waiting_discharge' ? 'waiting' : d.status %>"><%= d.status %></span></p>

                <% if (d.status === 'idle') { %>
                  <hr style="border-color:#ffffff22; margin:8px 0;">
                  <select class="select-tova" data-digestor="<%= d.id %>">
                    <option value="">Selecionar Tova</option>
                  </select>
                  <input class="input-ton" data-digestor="<%= d.id %>" placeholder="Toneladas solicitadas" type="number" step="0.1">
                  <input class="input-mp" data-digestor="<%= d.id %>" placeholder="Matéria-prima (ex: osso)">
                  <button class="btn btn-blue btn-full btn-start-trit" data-digestor-id="<%= d.id %>">Iniciar Trituração</button>
                <% } %>

                <% if (d.status === 'operating') { %>
                  <hr style="border-color:#ffffff22; margin:8px 0;">
                  <p><strong>Trituração ativa</strong></p>
                  <button class="btn btn-green btn-full btn-finish-trit" data-trit-id="">Encerrar Trituração</button>
                <% } %>

                <% if (d.status === 'cooking') { %>
                  <hr style="border-color:#ffffff22; margin:8px 0;">
                  <button class="btn btn-blue btn-full btn-finish-cook" data-cook-id="">Encerrar Cozimento</button>
                <% } %>

                <% if (d.status === 'waiting_discharge') { %>
                  <hr style="border-color:#ffffff22; margin:8px 0;">
                  <button class="btn btn-gray btn-full btn-open-discharge" data-digestor-id="<%= d.id %>">Registrar Descarga</button>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div id="dischargeModal" style="display:none; position:fixed; inset:0; align-items:center; justify-content:center; background:rgba(0,0,0,0.45); z-index:999;">
      <div class="card" style="width:420px; margin-bottom:0;">
        <div class="card-title">Registrar Descarga</div>
        <input id="dis_dig_id" type="hidden">
        <label>Toneladas descartadas</label>
        <input id="dis_ton" placeholder="0.0" type="number" step="0.1">
        <label>Observações</label>
        <textarea id="dis_notes" rows="3"></textarea>
        <div style="display:flex; gap:8px;">
          <button id="dis_save" class="btn btn-green btn-full">Salvar e Finalizar</button>
          <button id="dis_cancel" class="btn btn-red btn-full">Cancelar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    window.__OPERADOR_DATA__ = {
      usuario: <%- JSON.stringify(usuario || null) %>,
      digestores: <%- JSON.stringify(digestores || []) %>
    };
  </script>
  <script src="/js/operador.js"></script>
</body>
</html>
