<%- include("layouts/base_top", { title: "Painel do Operador", usuario: usuario }) %>

<h2 class="title-premium mb-4">Painel do Operador</h2>

<div class="row g-4" id="digestorGrid">
    <!-- preenchido pelo JS -->
</div>

<!-- LOG -->
<div class="card card-premium p-3 mt-4">
    <strong class="title-premium">Log do sistema:</strong>
    <div id="logContent" class="mt-2 text-muted small">Aguardando eventos...</div>
</div>

<!-- ======================= -->
<!-- MODAL: INICIAR CARGA -->
<!-- ======================= -->
<div class="modal fade" id="modalStartCarga" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium p-3">

      <h4 class="title-premium mb-2">Iniciar Carregamento</h4>
      <p class="text-muted small">Selecione a tova e a tonelagem desejada.</p>

      <input type="hidden" id="start_digestor_id">

      <div class="mb-3">
        <label class="form-label fw-bold">Tova</label>
        <select id="select_tova" class="form-select"></select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Toneladas desejadas</label>
        <input type="number" class="form-control" id="ton_solicitadas" min="0" step="0.1">
      </div>

      <div class="d-flex justify-content-end gap-2">
        <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-premium" onclick="confirmStartCarga()">Confirmar</button>
      </div>

    </div>
  </div>
</div>

<%- include("layouts/base_bottom") %>
