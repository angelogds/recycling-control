<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Login — Sistema Campo do Gado</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        body {
            background: #f5f7fa;
            font-family: Arial, sans-serif;
        }
        .login-container {
            max-width: 420px;
            margin: 80px auto;
            background: #fff;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 4px 12px #0002;
        }
        .login-container h2 {
            font-weight: 700;
            margin-bottom: 25px;
            text-align: center;
            color: #2a2a2a;
        }
        .input-group {
            margin-bottom: 20px;
        }
        input {
            width: 100%;
            padding: 14px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
        }
        button {
            width: 100%;
            padding: 14px;
            border-radius: 8px;
            background: #0C69F6;
            border: none;
            color: #fff;
            font-size: 17px;
            cursor: pointer;
            font-weight: bold;
            transition: .2s;
        }
        button:hover {
            background: #0854c9;
        }
        .alert {
            background: #ffdddd;
            padding: 12px;
            color: #a30000;
            border-left: 4px solid #d60000;
            border-radius: 6px;
            margin-bottom: 20px;
            text-align: center;
        }
        .footer-info {
            margin-top: 18px;
            text-align: center;
            font-size: 13px;
            color: #777;
        }
    </style>
</head>

<body>
    <div class="login-container">

        <h2>Acesso ao Sistema</h2>

        <% if (erro || error) { %>
            <div class="alert"><%= erro || error %></div>
        <% } %>

        <form action="/login" method="POST">

            <div class="input-group">
                <input type="text" name="username" placeholder="Usuário" required>
            </div>

            <div class="input-group">
                <input type="password" name="password" placeholder="Senha" required>
            </div>

            <button type="submit">Entrar</button>

        </form>

        <div class="footer-info">
            Campo do Gado © <%= new Date().getFullYear() %>
        </div>
    </div>

</body>
</html>
