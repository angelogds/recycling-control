<!-- portaria_painel.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Portaria — Campo do Gado</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="top-bar">
    <div>Portaria • <%= usuario && usuario.nome ? usuario.nome : 'Portaria' %></div>
    <div><a href="/logout">Sair</a></div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Chegadas de Caminhões</div>
      <div style="margin-bottom:12px;">
        <a class="btn btn-green" href="/portaria/chegada">Registrar Chegada</a>
      </div>

      <table class="table-premium">
        <thead>
          <tr><th>Placa</th><th>Toneladas declaradas</th><th>Chegada</th><th>Status</th></tr>
        </thead>
        <tbody id="entriesBody">
          <tr><td colspan="4">Aguardando registros...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

<script>
  const socket = io();
  const entriesBody = document.getElementById('entriesBody');

  socket.on('entries:update', (rows) => {
    entriesBody.innerHTML = '';
    if (!rows || rows.length === 0) {
      entriesBody.innerHTML = '<tr><td colspan="4">Nenhuma entrada pendente</td></tr>';
      return;
    }
    rows.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${r.truck_plate}</td><td>${r.toneladas_declared||0}</td><td>${r.arrival_at||''}</td><td>${r.status||''}</td>`;
      entriesBody.appendChild(tr);
    });
  });

  // request initial state via socket by connecting (server broadcasts on connect)
</script>
</body>
</html>
