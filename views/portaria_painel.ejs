<%- include('layouts/base_top', { title: "Portaria", usuario: usuario }) %>

<h2 class="title-premium mb-3">Portaria – Controle de Chegada</h2>

<a class="btn btn-premium mb-4" href="/portaria/chegada">Registrar Chegada</a>

<div id="listaChegadas" class="row g-3"></div>

<script>
async function carregarChegadas(){
    const dados = await fetch('/api/entries/pending').then(r=>r.json());
    const lista = document.getElementById("listaChegadas");
    lista.innerHTML = "";

    dados.forEach(item => {
        const col = document.createElement("div");
        col.className = "col-md-4";

        col.innerHTML = `
            <div class="card card-premium p-3">
                <h5 class="title-premium">${item.truck_plate}</h5>
                <p class="mb-1"><strong>${item.toneladas_declared} tn</strong></p>
                <p class="small text-muted">Status: ${item.status}</p>
            </div>
        `
        lista.appendChild(col);
    });
}
carregarChegadas();
</script>

<%- include('layouts/base_bottom') %>
