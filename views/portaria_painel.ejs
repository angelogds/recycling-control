<%- include('layouts/base_top', { title: "Portaria - Painel", usuario: usuario }) %>

<div class="container premium-box">
    <h1 class="page-title">🚛 Controle de Portaria</h1>

    <div class="actions-row">
        <a href="/portaria/chegada" class="btn btn-primary btn-lg">
            ➕ Registrar Chegada
        </a>
        <a href="/logout" class="btn btn-secondary btn-lg">Sair</a>
    </div>

    <hr/>

    <h3>Entradas recentes</h3>

    <div id="entriesList" class="entries-grid">
        <p class="text-muted">Carregando entradas...</p>
    </div>
</div>

<script>
const socket = io();

// Atualiza lista realtime
socket.on("entries:update", (rows) => {
    const div = document.getElementById("entriesList");
    if (!rows || rows.length === 0) {
        div.innerHTML = "<p class='text-muted'>Nenhuma entrada registrada.</p>";
        return;
    }

    div.innerHTML = rows.map(r => `
        <div class="entry-card">
            <h4>🚛 Placa: <b>${r.truck_plate}</b></h4>
            <p><b>Toneladas declaradas:</b> ${r.toneladas_declared} tn</p>
            <p><b>Status:</b> ${r.status}</p>
            <p class="small text-muted">Chegada: ${r.arrival_at}</p>
        </div>
    `).join("");
});
</script>

<%- include('layouts/base_bottom') %>
