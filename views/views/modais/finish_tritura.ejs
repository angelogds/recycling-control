cat > views/modais/finish_tritura.ejs << 'EOF'
<!-- MODAL: Finalizar Trituração -->
<div class="modal fade" id="modalFinishTrit" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-premium">
      <div class="modal-body">
        <h4 class="title-premium">Finalizar Trituração</h4>
        <input type="hidden" id="finish_trit_id">
        <div class="mb-3">
          <label class="form-label">Toneladas trituradas</label>
          <input id="ton_trituradas" type="number" class="form-control" step="0.1" min="0">
        </div>
        <div class="d-flex justify-content-end gap-2">
          <button class="btn btn-outline-premium" data-bs-dismiss="modal">Cancelar</button>
          <button class="btn btn-premium" onclick="confirmFinishTrit()">Confirmar</button>
        </div>
      </div>
    </div>
  </div>
</div>
EOF
