cat > views/tovas/tovas_dashboard.ejs << 'EOF'
<%- include('../layouts/base_top', { title: "Tovas", usuario: usuario }) %>

<h2 class="title-premium mb-4">Painel das Tovas</h2>

<div class="row g-4" id="tovasGrid"></div>

<script>
async function loadTovas(){
  const tovas = await fetch('/api/tovas').then(r=>r.json());
  const grid = document.getElementById('tovasGrid'); grid.innerHTML='';
  tovas.forEach(t=>{
    grid.innerHTML += `<div class="col-md-6">
      <div class="card card-premium p-3">
        <h4 class="title-premium">${t.nome}</h4>
        <p class="small text-muted">Capacidade: ${t.capacidade_tn} tn</p>
        <div class="progress-premium mb-2">
          <div class="progress-premium-inner" style="width:${(t.current_tn / t.capacidade_tn) * 100}%;"></div>
        </div>
        <p><strong>Atual:</strong> ${t.current_tn} tn</p>
        <a class="btn btn-outline-premium btn-sm" href="/tovas/${t.id}/editar">Editar</a>
      </div>
    </div>`;
  });
}
loadTovas();
setInterval(loadTovas,5000);
</script>

<%- include('../layouts/base_bottom') %>
EOF
