<!-- admin_users_list.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin — Usuários</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div>Admin • Usuários</div>
    <div><a href="/operador/painel">Voltar</a></div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Lista de Usuários</div>
      <div style="margin-bottom:12px;">
        <a class="btn btn-green" href="/admin/users/new">Novo Usuário</a>
      </div>

      <table class="table-premium">
        <thead><tr><th>#</th><th>Username</th><th>Nome</th><th>Role</th><th>Ações</th></tr></thead>
        <tbody>
          <% if (!users || users.length === 0) { %>
            <tr><td colspan="5">Nenhum usuário cadastrado</td></tr>
          <% } else { %>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><%= u.nome %></td>
                <td><%= u.role %></td>
                <td>
                  <a class="btn btn-gray" href="/admin/users/<%= u.id %>/edit">Editar</a>
                  <form style="display:inline" action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Excluir usuário?');">
                    <button class="btn btn-red" type="submit">Excluir</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
