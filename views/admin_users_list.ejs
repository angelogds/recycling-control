<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Admin – Usuários</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
body { margin:0; padding:20px; background:#f4f6f5; font-family:"Inter"; }
h1 { color:#0a361a; margin-bottom:18px; }

.btn {
    padding: 10px 18px;
    border:none;
    border-radius:8px;
    background:#0ac44d;
    color:white;
    font-weight:bold;
    text-decoration:none;
}
.btn:hover { background:#08993d; }

table {
    width:100%;
    border-collapse:collapse;
    background:white;
    margin-top:20px;
    border-radius:10px;
    overflow:hidden;
}
th {
    background:#0f5226;
    color:white;
    padding:12px;
}
td {
    padding:14px;
    border-bottom:1px solid #ddd;
}
tr:hover {
    background:#eef6ee;
}
.action-btn {
    padding:6px 12px;
    border-radius:6px;
    font-size:14px;
    color:white;
}
.edit { background:#ffaa00; }
.del { background:#ff3e3e; }
</style>

</head>
<body>

<h1>Gerenciamento de Usuários</h1>

<a href="/admin/users/new" class="btn">+ Criar Novo Usuário</a>

<table>
<tr>
    <th>Nome</th>
    <th>Usuário</th>
    <th>Função</th>
    <th>Ações</th>
</tr>

<% users.forEach(u => { %>
<tr>
    <td><%= u.nome %></td>
    <td><%= u.username %></td>
    <td><%= u.role %></td>
    <td>
        <a href="/admin/users/<%= u.id %>/edit" class="action-btn edit">Editar</a>
        <a href="/admin/users/<%= u.id %>/delete" class="action-btn del">Excluir</a>
    </td>
</tr>
<% }) %>

</table>

</body>
</html>
