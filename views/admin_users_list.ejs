<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Usuários - Administração</title>

    <style>
        body { background:#eef2f6; margin:0; font-family:Arial; }
        .top-bar {
            background:#0C69F6; color:white; padding:18px 25px;
            font-size:22px; font-weight:bold;
            display:flex; justify-content:space-between;
        }
        .container { padding:25px; }
        .btn {
            padding:10px 18px; border-radius:10px; 
            border:none; cursor:pointer; font-weight:bold;
        }
        .btn-add { background:#0C69F6; color:white; }
        .btn-edit { background:#FFC107; color:#222; }
        .btn-delete { background:#D9534F; color:white; }

        table {
            width:100%; border-collapse:collapse; margin-top:20px;
            background:white; border-radius:12px; overflow:hidden;
            box-shadow:0 4px 10px #0002;
        }
        th, td {
            padding:14px; text-align:left; border-bottom:1px solid #ddd;
        }
        th { background:#0C69F6; color:white; }
        tr:hover { background:#f4f7ff; }
    </style>
</head>

<body>

<div class="top-bar">
    <span>Gestão de Usuários</span>
    <a href="/operador/painel" style="color:white;text-decoration:none;">Painel</a>
</div>

<div class="container">

    <button class="btn btn-add" onclick="location.href='/admin/users/new'">+ Novo Usuário</button>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Usuário</th>
                <th>Nome</th>
                <th>Papel</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
        <% users.forEach(u => { %>
            <tr>
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><%= u.nome %></td>
                <td><%= u.role %></td>
                <td>
                    <button class="btn btn-edit" onclick="location.href='/admin/users/<%= u.id %>/edit'">Editar</button>
                    <button class="btn btn-delete" onclick="if(confirm('Excluir usuário?')) location.href='/admin/users/<%= u.id %>/delete'">Excluir</button>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>

</div>

</body>
</html>
