<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Novo Usuário</title>

    <style>
        body { background:#eef2f6; margin:0; font-family:Arial; }
        .top-bar {
            background:#0C69F6; color:white; padding:18px 25px;
            font-size:22px; font-weight:bold;
            display:flex; justify-content:space-between;
        }
        .container { padding:25px; }
        .card {
            max-width:450px; margin:auto; background:white;
            padding:25px; border-radius:15px; box-shadow:0 4px 12px #0003;
        }
        label { font-weight:bold; margin-top:15px; display:block; }
        input, select {
            width:100%; padding:14px; border-radius:10px;
            border:1px solid #bbb; margin-top:5px;
        }
        .btn {
            width:100%; padding:14px; border-radius:10px; margin-top:20px;
            border:none; font-size:18px; cursor:pointer; font-weight:bold;
        }
        .btn-save { background:#0C69F6; color:white; }
    </style>
</head>

<body>

<div class="top-bar">
    <span>Novo Usuário</span>
    <a href="/admin/users" style="color:white;text-decoration:none;">Voltar</a>
</div>

<div class="container">
    <form class="card" method="POST" action="/admin/users/new">
        <label>Usuário:</label>
        <input type="text" name="username" required>

        <label>Nome completo:</label>
        <input type="text" name="nome" required>

        <label>Senha:</label>
        <input type="password" name="password" required>

        <label>Papel:</label>
        <select name="role" required>
            <option value="operador">Operador</option>
            <option value="portaria">Portaria</option>
            <option value="admin">Administrador</option>
        </select>

        <button class="btn btn-save" type="submit">Salvar Usuário</button>
    </form>
</div>

</body>
</html>
