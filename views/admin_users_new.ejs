<%- include('layouts/base_top', { title: "Novo Usuário", usuario: usuario }) %>

<div class="container premium-box">
    <h1 class="page-title">➕ Criar Novo Usuário</h1>

    <form action="/admin/users/create" method="POST" class="form-premium">

        <label>Usuário (login):</label>
        <input name="username" class="form-control form-control-lg" required />

        <label>Nome Completo:</label>
        <input name="nome" class="form-control form-control-lg" required />

        <label>Função:</label>
        <select name="role" class="form-control form-control-lg">
            <option value="operador">Operador</option>
            <option value="portaria">Portaria</option>
            <option value="admin">Administrador</option>
        </select>

        <label>Senha:</label>
        <input type="password" name="password" class="form-control form-control-lg" required />

        <button class="btn btn-success btn-lg w-100 mt-3">Salvar Usuário</button>
    </form>

    <a href="/admin/users" class="btn btn-secondary btn-lg w-100 mt-3">Voltar</a>
</div>

<%- include('layouts/base_bottom') %>
