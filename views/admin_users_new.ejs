<!-- admin_users_new.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Novo Usuário — Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div>Admin • Novo Usuário</div>
    <div style="display:flex; gap:10px; align-items:center;">
      <button class="theme-toggle" type="button" data-theme-toggle>🌙 Escuro</button>
      <a href="/admin/users">Voltar</a>
    </div>
  </div>

  <div class="container">
    <div class="card" style="max-width:600px; margin:auto;">
      <div class="card-title">Criar Usuário</div>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert"><%= error %></div><% } %>

      <form method="POST" action="/admin/users">
        <label>Username</label>
        <input name="username" required>
        <label>Nome</label>
        <input name="nome">
        <label>E-mail</label>
        <input name="email" type="email" placeholder="usuario@empresa.com">
        <label>Senha</label>
        <input name="password" type="password" required>
        <label>Role</label>
        <select name="role">
          <option value="operador">Operador</option>
          <option value="portaria">Portaria</option>
          <option value="admin">Administrativo</option>
        </select>

        <div style="margin-top:12px;">
          <button class="btn btn-green btn-full" type="submit">Criar</button>
        </div>
      </form>
    </div>
  </div>
  <script src="/js/theme.js"></script>
</body>
</html>
