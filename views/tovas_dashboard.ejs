<!-- tovas_dashboard.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Tovas — Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div>Tovas</div>
    <div><a href="/operador/painel">Voltar</a></div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Tovas Cadastradas</div>
      <div class="row">
        <% if (!tovas || tovas.length === 0) { %>
          <div class="col-12">Nenhuma tova cadastrada.</div>
        <% } else { %>
          <% tovas.forEach(t => { %>
            <div class="col-4">
              <div class="card digestor-box">
                <div class="digestor-name"><%= t.nome %></div>
                <div>Capacidade: <%= t.capacidade_tn %> tn</div>
                <div>Atual: <%= t.current_tn || 0 %> tn</div>
                <div style="margin-top:8px;">
                  <a class="btn btn-gray" href="/tovas/<%= t.id %>/editar">Editar</a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
