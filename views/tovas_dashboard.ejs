<h3>Tovas — Situação Atual</h3>

<div id="listaTovas" class="row g-2"></div>

<script>
async function carregar(){
    const tovas = await fetch('/api/tovas').then(r=>r.json());

    const area = document.getElementById("listaTovas");
    area.innerHTML = "";

    tovas.forEach(t => {
        const div = document.createElement("div");
        div.className = "col-md-4";
        div.innerHTML = `
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>${t.nome}</h5>
                    <p>Atual: ${t.current_tn} tn</p>
                    <p class="small text-muted">Capacidade: ${t.capacidade_tn}</p>
                </div>
            </div>
        `;
        area.appendChild(div);
    });
}

carregar();
</script>
