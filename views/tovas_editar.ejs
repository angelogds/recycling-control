<!-- tovas_editar.ejs -->
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Editar Tova</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="top-bar">
    <div>Editar Tova — <%= tova.nome %></div>
    <div><a href="/tovas">Voltar</a></div>
  </div>

  <div class="container">
    <div class="card" style="max-width:600px; margin:auto;">
      <div class="card-title">Editar Tova</div>

      <form method="POST" action="/tovas/<%= tova.id %>/update">
        <label>Nome</label>
        <input name="nome" value="<%= tova.nome %>" required>
        <label>Capacidade (tn)</label>
        <input name="capacidade_tn" type="number" step="0.1" value="<%= tova.capacidade_tn %>">
        <div style="margin-top:12px;">
          <button class="btn btn-green btn-full" type="submit">Salvar</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
