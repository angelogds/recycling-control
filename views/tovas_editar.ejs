<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Editar Tova</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    body {
        margin: 0;
        padding: 40px;
        background: #eef5f0;
        font-family: "Inter";
    }

    .card {
        max-width: 500px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 14px;
        box-shadow: 0 0 12px rgba(0,0,0,0.15);
    }

    h2 { margin-bottom: 20px; color: #0f5226; }

    label { margin-top: 10px; display: block; }
    input {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 16px;
        margin-top: 4px;
    }

    .btn {
        width: 100%;
        margin-top: 20px;
        padding: 12px;
        background: #0ac44d;
        border: none;
        color: white;
        border-radius: 10px;
        cursor: pointer;
        font-weight: bold;
        font-size: 16px;
    }

    .btn:hover { background: #0e9c3f; }

    .back {
        text-align: center;
        margin-top: 15px;
        display: block;
        text-decoration: none;
        color: #555;
    }
</style>

</head>
<body>

<div class="card">

<h2>Editar Tova</h2>

<form action="/tovas/<%= tova.id %>/update" method="POST">

    <label>Nome</label>
    <input type="text" name="nome" value="<%= tova.nome %>" required>

    <label>Capacidade (Toneladas)</label>
    <input type="number" step="0.01" name="capacidade_tn" value="<%= tova.capacidade_tn %>" required>

    <button class="btn">Salvar Alterações</button>

</form>

<a href="/tovas" class="back">Voltar</a>

</div>

</body>
</html>
