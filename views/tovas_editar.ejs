<%- include('layouts/base_top', { title: "Editar Tova", usuario: usuario }) %>

<h2 class="title-premium mb-4">Editar Tova</h2>

<form method="POST" action="/tovas/<%= tova.id %>/update" class="card card-premium p-4">

    <label class="form-label">Nome</label>
    <input type="text" class="form-control mb-3" name="nome" value="<%= tova.nome %>">

    <label class="form-label">Capacidade (tn)</label>
    <input type="number" class="form-control mb-3" name="capacidade_tn" value="<%= tova.capacidade_tn %>">

    <button class="btn btn-premium w-100">Salvar</button>
</form>

<%- include('layouts/base_bottom') %>
