cat > views/tovas_editar.ejs << 'EOF'
<%- include("layouts/base_top", { title: "Editar Tova", usuario: usuario }) %>

<h2 class="title-premium mb-4">Editar Tova</h2>

<div class="card card-premium p-4">
    <form method="POST" action="/tovas/<%= tova.id %>/update">
        <div class="mb-3">
            <label class="form-label fw-bold">Nome</label>
            <input name="nome" value="<%= tova.nome %>" class="form-control" required>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Capacidade (tn)</label>
            <input name="capacidade_tn" type="number" step="0.1" value="<%= tova.capacidade_tn %>" class="form-control" required>
        </div>
        <div class="d-flex gap-2">
            <a href="/tovas" class="btn btn-outline-premium">Cancelar</a>
            <button class="btn btn-premium">Salvar</button>
        </div>
    </form>
</div>

<%- include("layouts/base_bottom") %>
EOF
