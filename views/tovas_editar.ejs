<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Tova</title>

    <style>
        body {
            background: #eef2f6;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .top-bar {
            background: #0C69F6;
            color: white;
            padding: 18px 25px;
            font-size: 22px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
        }

        .container {
            padding: 25px;
        }

        .card {
            max-width: 480px;
            margin: auto;
            background: white;
            padding: 28px;
            border-radius: 15px;
            box-shadow: 0 4px 12px #0003;
        }

        label {
            font-weight: bold;
            margin-top: 15px;
            display: block;
        }

        input {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            border: 1px solid #bbb;
            margin-top: 5px;
            font-size: 15px;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            margin-top: 20px;
            border: none;
            font-size: 18px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-save {
            background: #0C69F6;
            color: white;
        }

        .btn-cancel {
            background: #999;
            color: white;
            margin-top: 10px;
        }
    </style>

</head>

<body>

<div class="top-bar">
    <span>Editar Tova</span>
    <a href="/tovas" style="color:white;text-decoration:none;">Voltar</a>
</div>

<div class="container">

    <form class="card" method="POST" action="/tovas/<%= tova.id %>/update">

        <label>Nome da Tova:</label>
        <input type="text" name="nome" value="<%= tova.nome %>" required>

        <label>Capacidade (Ton):</label>
        <input type="number" step="0.01" name="capacidade_tn" value="<%= tova.capacidade_tn %>" required>

        <label>Nível Atual (Ton):</label>
        <input type="number" step="0.01" name="current_tn" value="<%= tova.current_tn %>" required>

        <button class="btn btn-save">Salvar Alterações</button>
        <button type="button" class="btn btn-cancel" onclick="location.href='/tovas'">Cancelar</button>

    </form>

</div>

</body>
</html>
