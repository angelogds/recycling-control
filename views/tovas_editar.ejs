<%- include('layouts/base_top', { title: "Editar Tova", usuario: usuario }) %>

<h3>Editar <%= tova.nome %></h3>
<form method="post" action="/tovas/<%= tova.id %>/update">
  <div class="mb-3">
    <label>Nome</label>
    <input name="nome" value="<%= tova.nome %>" class="form-control">
  </div>
  <div class="mb-3">
    <label>Capacidade (tn)</label>
    <input name="capacidade_tn" value="<%= tova.capacidade_tn %>" class="form-control" type="number" step="0.1">
  </div>
  <button class="btn btn-primary">Salvar</button>
</form>

<%- include('layouts/base_bottom') %>
