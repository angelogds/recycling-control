app.post("/api/cooking/start", (req, res) => {
    const { cooking_id } = req.body;

    if (!cooking_id) {
        return res.status(400).json({ error: "ID do cozimento não informado." });
    }

    const now = new Date().toISOString();

    db.run(
        `UPDATE cooking_cycles
         SET start_cook_at = ?, status = 'started'
         WHERE id = ?`,
        [now, cooking_id],
        (err) => {
            if (err) return res.status(500).json({ error: err.message });

            broadcastState();
            res.json({ ok: true });
        }
    );
});
